# ==============================================================
#  AI Gen Platform — environment variable template
#
#  Copy this file to `.env.local` and fill in values as needed.
#  `.env.local` is git-ignored — never commit credentials.
#
#  Application credentials are entered in the UI's left-side
#  CredentialsPanel. The server runtime NO LONGER reads AKSK
#  from this file for normal application traffic.
# ==============================================================


# ── 1. BytePlus TOS — CLI-only (`npm run tos:bootstrap`) ──────────────
# Server runtime does NOT read these. They exist only for the optional
# `npm run tos:bootstrap` CLI script (manual CORS setup). In normal use,
# TOS CORS is automatically configured when users verify TOS credentials
# in the UI. Application traffic uses per-user creds entered in the UI.
#
# Where to get these:
#   https://console.byteplus.com/iam/keymanage/  (AccessKey ID / SecretKey)
#   https://console.byteplus.com/tos/bucket      (Bucket / Region)

TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_REGION=ap-southeast-1
TOS_ENDPOINT=tos-ap-southeast-1.bytepluses.com
TOS_BUCKET=

# Object key prefix; uploaded reference files land under this folder.
TOS_KEY_PREFIX=seedance-2-0/

# Validity (in seconds) of the GET pre-signed URL handed to Seedance.
# Default 3 hours. Maximum 604800 (7 days, TOS hard limit).
TOS_GET_URL_TTL_SECONDS=10800

# Comma-separated browser origins allowed by the bucket CORS policy.
# Add additional dev hosts if you serve from a non-default port.
TOS_CORS_ORIGINS=http://localhost:5173


# ── 2. BytePlus ModelArk / Seedance (NOT read from env) ───────
# These are entered via the UI's left panel:
#   - API 金鑰        →  ModelArk API Key
#   - 自訂接入點      →  Endpoint ID (e.g. ep-20260327154051-xxxxx)
#   - 影片生成接入點 (Seedance 2.5)（選填）→ Endpoint ID；留空則直接以
#     Model ID dreamina-seedance-2-5-260628 呼叫。
#   - 文字生成接入點  →  Seed LLM Endpoint ID（提示詞優化需要）
# They are stored in the browser's localStorage under key `ai-gen-auth`.
#
# 拖放 .env 匯入時，這四個接入點對應的變數名（各自也接受若干別名）：
#   SEEDANCE_2_0_ENDPOINT   → 影片生成接入點
#   SEEDANCE_2_5_ENDPOINT   → 影片生成接入點 (Seedance 2.5)
#   SEEDREAM_5_0_ENDPOINT   → 圖片生成接入點
#   TEXT_LLM_SEED_ENDPOINT  → 文字生成接入點
#
# Where to get them:
#   API Key:
#     https://console.byteplus.com/ark/region:ark+ap-southeast-1/apiKey
#   Endpoint ID:
#     https://console.byteplus.com/ark/region:ark+ap-southeast-1/endpoint
#
# Reference base URL (already proxied by Vite, no override needed in dev):
#   https://ark.ap-southeast.bytepluses.com
#
# In production you would set this build-time variable instead:
#   VITE_API_BASE_URL=https://ark.ap-southeast.bytepluses.com


# ── 3. BytePlus ARK Asset Library — UNUSED at runtime ─────────
# Application uses per-user creds entered in the UI. These are kept only for
# ad-hoc CLI debugging.
#
# IMPORTANT: This must be a SEPARATE AccessKey / SecretKey from the TOS pair
# above. The two AK/SK pairs serve different services (TOS vs ARK) and should
# be scoped with only the permissions they need. Do NOT reuse the TOS AK/SK.
#
# Where to get these:
#   AccessKey ID / SecretKey:  https://console.byteplus.com/iam/keymanage/
#   ProjectName: the project under which your asset groups live
#                (must match the project of your Seedance inference endpoint)
#                Replace `default` below with your actual ModelArk project name.

BYTEPLUS_AK=
BYTEPLUS_SK=
BYTEPLUS_PROJECT_NAME=default


# ── 4. Server runtime (optional; sensible defaults if unset) ──
# Read by the Express backend at boot. Leave commented unless you need
# to override.
#
#   PORT             → server/config/env.ts          (Express listen port)
#   EXPORTS_DIR      → server/routes/localApi.ts +   (where /local-api/export
#                      server/routes/exportsStatic.ts  writes JSON, where mp4 /
#                                                      frame downloads land, and
#                                                      what /exports/* serves)
#   DIST_DIR         → server/routes/spaFallback.ts  (production SPA assets;
#                                                      npm run build's output)
#   PLATFORM_ORIGIN  → server/routes/tosVerify.ts    (origin merged
#                                                      into the user's
#                                                      TOS bucket CORS
#                                                      during /verify)

# PORT=3000
# EXPORTS_DIR=./exports
# DIST_DIR=./dist
# PLATFORM_ORIGIN=http://localhost:5173
