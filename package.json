{
  "name": "dgen-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,server -c blue,green \"vite\" \"npm run server:dev\"",
    "dev:vite-only": "vite",
    "server:dev": "tsx watch server/index.ts",
    "server:start": "NODE_ENV=production tsx server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tos:bootstrap": "tsx scripts/tos-bootstrap.ts",
    "tos:cors:show": "tsx scripts/tos-bootstrap.ts --show-cors",
    "verify:frame-roles": "tsx scripts/verify-frame-roles.ts",
    "verify:seedream": "tsx scripts/verify-seedream.ts",
    "verify:chat": "tsx scripts/verify-chat.ts",
    "verify:cache": "tsx scripts/verify-cache.ts"
  },
  "dependencies": {
    "axios": "^1.14.0",
    "express": "^5.2.1",
    "fflate": "^0.8.2",
    "http-proxy-middleware": "^3.0.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-dropzone": "^15.0.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.13.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^4.17.25",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@volcengine/tos-sdk": "^2.9.1",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.2"
  }
}
